{
  "name": "streetwear-tycoon",
  "productName": "Streetwear Tycoon",
  "version": "0.2.0",
  "description": "Underground streetwear brand tycoon game",
  "author": "Streetwear Tycoon",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.7",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/rubik-bubbles": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.streetwear.tycoon",
    "productName": "Streetwear Tycoon",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "StreetwearTycoon.exe"
    }
  }
}
